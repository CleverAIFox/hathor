# 복사해서 .env로 쓴다. .env는 절대 커밋하지 않는다 (§5.5).
#
# **기기마다 다른 값은 전부 여기에만 적는다** (D-0066). 셸에 export하지 않는다.
# CLI가 시작할 때 이 파일을 읽는다. 셸에 이미 있는 값은 덮지 않는다.
# 확인:  make env

# **`make setup`이 아래 두 줄을 탐지해 채운다.** 손으로 치지 않는다 (D-0068).
# 기기 값을 이 예시 파일에 박지 않는다 — 예시는 공유되고 값은 기기마다 다르다.

# 음원 라이브러리 루트. 드라이브 문자가 기기마다 다르다 (D-0009).
HATHOR_LIBRARY_ROOT=

# 패치를 받아 두는 폴더. `make apply`가 여기서 가장 최근 .patch를 찾는다.
# 윈도우 사용자 이름도 기기마다 다르다 (광인사 foxlo · 리전 Fox).
HATHOR_PATCH_DIR=

# ---- 아래는 docker compose용이다 ----

POSTGRES_USER=hathor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hathor
MONGO_USER=hathor
MONGO_PASSWORD=change-me
RABBITMQ_USER=hathor
RABBITMQ_PASSWORD=change-me
MINIO_ROOT_USER=hathor
MINIO_ROOT_PASSWORD=change-me-min-8-chars
GRAFANA_PASSWORD=change-me

DATABASE_URL=postgresql://hathor:change-me@localhost:5432/hathor
REDIS_URL=redis://localhost:6379/0
AMQP_URL=amqp://hathor:change-me@localhost:5672//
S3_ENDPOINT_URL=http://localhost:9000
MONGO_URL=mongodb://hathor:change-me@localhost:27017/hathor?authSource=admin
